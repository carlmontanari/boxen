{{ $layout := starlark "nvidia_cumulusvx_breakout.star" "layout" -}}
{{ if $layout.lanes -}}
# Simulate lanes with additional virtio NICs; leave hardware ports.conf unchanged.
stty -echo; cat > /tmp/boxen-breakout.sh <<'BOXEN_BREAKOUT_EOF'
set -eu
until systemctl is-active --quiet switchd && systemctl is-active --quiet nvued; do sleep 2; done
rules=/etc/udev/rules.d/70-cumulus-breakout.rules
echo '# Generated by Boxen for simulated breakout lanes.' > "$rules"
rename_lane() {
  source=$1; target=$2
  if ip link show dev "$target" >/dev/null 2>&1; then source=$target; fi
  mac=$(cat "/sys/class/net/$source/address")
  printf 'SUBSYSTEM=="net", ACTION=="add", ATTR{address}=="%s", NAME="%s"\n' "$mac" "$target" >> "$rules"
  if [ "$source" != "$target" ]; then
    ip link set dev "$source" down
    ip link set dev "$source" name "$target"
  fi
}
{{ range $layout.lanes -}}
rename_lane swp{{ .Index }} {{ .Name }}
{{ end -}}
udevadm control --reload-rules
# Restore saved interface state when NVUE has no configuration diff.
ifreload -a
BOXEN_BREAKOUT_EOF
stty echo && printf '%s\n' 'Clab123!' | sudo -S timeout 300 bash /tmp/boxen-breakout.sh && rm -f /tmp/boxen-breakout.sh && printf '\nBOXEN_BREAKOUT_OK\n'
{{ else -}}
printf '\nBOXEN_BREAKOUT_OK\n'
{{ end -}}
